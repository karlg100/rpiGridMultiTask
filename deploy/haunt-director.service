# Installed by deploy/install.sh, which fills in @USER@ and @DIR@.
[Unit]
Description=Halloween show director (haunt)
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
WorkingDirectory=@DIR@
EnvironmentFile=-/etc/haunt/env
ExecStart=/usr/bin/python3 -m haunt director show.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
