# Installed by deploy/install.sh, which fills in @USER@ and @DIR@.
[Unit]
Description=Halloween show DMX output (haunt): fog machine
After=network-online.target
Wants=network-online.target

[Service]
User=@USER@
SupplementaryGroups=dialout
WorkingDirectory=@DIR@
EnvironmentFile=-/etc/haunt/env
ExecStart=/usr/bin/python3 -m haunt dmx -c /etc/haunt/dmx.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
